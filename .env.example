# ==========================================================
# EasySSH 环境变量示例（复制为 .env 后按需修改）
# ==========================================================

# 运行模式
# - development：开发
# - production：生产
ENV=production

# ----------------------------------------------------------
# 端口与服务地址
# ----------------------------------------------------------
# 前端开发端口（scripts/dev.sh 启动时使用）
WEB_PORT=3000

# 后端服务端口（Go）
PORT=8520

# ----------------------------------------------------------
# 安全与 Cookie（Bearer + Refresh Cookie）
# ----------------------------------------------------------
# JWT 密钥（请务必替换为强随机值）
# 生成方式：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# 加密密钥，用于敏感数据保护（包括 2FA secret 加密与备份码 HMAC）
# 生成方式：openssl rand -base64 32
# ⚠️ 警告：此密钥用于加密敏感数据，丢失后将无法解密已加密的数据
ENCRYPTION_KEY=CHANGE_ME_IN_PRODUCTION

# Cookie 安全策略
# - COOKIE_SECURE：HTTPS 环境必须 true；HTTP 开发环境必须 false
# - COOKIE_DOMAIN：Cookie 域名（多子域共享时设置为 .example.com），留空表示当前域
# - COOKIE_SAMESITE：lax | none | strict
#   • 同源/同站：lax（推荐）
#   • 跨域直连：none（必须搭配 HTTPS，即 COOKIE_SECURE=true）
COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# ----------------------------------------------------------
# JWT 过期与刷新
# ----------------------------------------------------------
# 访问令牌过期时间（分钟，5-1440）
JWT_ACCESS_EXPIRE_MINUTES=15
# 刷新令牌：滑动过期与绝对上限（天）
JWT_REFRESH_IDLE_EXPIRE_DAYS=7
JWT_REFRESH_ABSOLUTE_EXPIRE_DAYS=30
# 刷新令牌安全机制
JWT_REFRESH_ROTATE=true
JWT_REFRESH_REUSE_DETECTION=true

# ----------------------------------------------------------
# 数据库配置
# ----------------------------------------------------------
# 默认使用 SQLite，适合个人/小团队单实例部署。
# 可选：sqlite | postgres（也兼容 pgsql/postgresql）| mysql
DB_DRIVER=sqlite
DB_PATH=./data/easyssh.db

# PostgreSQL 示例：
# DB_DRIVER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=easyssh
# DB_NAME=easyssh_db
# DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
# DB_SSLMODE=disable
#
# MySQL 示例：
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=easyssh
# DB_NAME=easyssh_db
# DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

DB_HOST=localhost
DB_PORT=5432
DB_USER=easyssh
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION # 生成方式：openssl rand -base64 16
DB_NAME=easyssh_db
DB_SSLMODE=disable  # disable | require | verify-ca | verify-full

# 数据库连接池参数
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=60   # 分钟
DB_CONN_MAX_IDLE_TIME=10  # 分钟
